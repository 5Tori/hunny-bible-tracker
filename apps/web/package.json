{
  "name": "@hunny-bible-tracker/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "deploy": "NEXT_PUBLIC_SITE_URL=https://hunnybibletracker.com NEXT_PUBLIC_GTM_ID=GTM-TWDZMRJW pnpm run cf:build && pnpm run cf:deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "icons:sync": "bash scripts/sync-brand-icons.sh"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.0",
    "@supabase/supabase-js": "^2.49.0",
    "postgres": "^3.4.5",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.86.0"
  }
}
