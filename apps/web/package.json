{
  "name": "@hunny-bible-tracker/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "dev:offline": "node scripts/run-dev.mjs --offline",
    "dev:online": "node scripts/run-dev.mjs --online",
    "sync:message-cards": "vitest run scripts/sync-message-cards-to-db.test.ts",
    "sync:message-cards:write": "SYNC_MESSAGE_CARDS_WRITE=1 vitest run scripts/sync-message-cards-to-db.test.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "node scripts/run-cf-build.mjs && opennextjs-cloudflare preview",
    "cf:build": "node scripts/run-cf-build.mjs",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "deploy": "pnpm run cf:build && pnpm run cf:deploy",
    "db:check": "node scripts/check-db.mjs",
    "infra:sync-hyperdrive": "node scripts/sync-hyperdrive-origin.mjs --apply",
    "infra:verify": "node scripts/verify-infra.mjs",
    "bench:api": "node scripts/bench-api.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "icons:sync": "bash scripts/sync-brand-icons.sh"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.0",
    "@supabase/supabase-js": "^2.49.0",
    "next": "^15.0.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.86.0"
  }
}
