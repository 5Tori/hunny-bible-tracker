{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hunny-bible-tracker-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hunny-bible-tracker-web"
    }
  ],
  // Required for Supabase Postgres from Workers (create in dashboard or via CLI).
  // See docs/CLOUDFLARE_DEPLOY.md — replace REPLACE_HYPERDRIVE_ID after creation.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "403144eafd1b46f7b38e60472478fb34",
      // Optional: set for `pnpm preview` only (use pooler URL from .env.local; do not commit password).
      "localConnectionString": "postgresql://postgres.tbexpdwipdjgcjtlujis:REPLACE_DB_PASSWORD@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
    }
  ],
  "vars": {
    "NEXTJS_ENV": "production",
    "NEXT_PUBLIC_SITE_URL": "https://hunnybibletracker.com",
    "CANONICAL_SITE_HOST": "hunnybibletracker.com",
    "NEXT_PUBLIC_SUPABASE_URL": "https://tbexpdwipdjgcjtlujis.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRiZXhwZHdpcGRqZ2NqdGx1amlzIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk5NDAyODcsImV4cCI6MjA5NTUxNjI4N30.NPeR49lPukRiT1BQ0nMO2hf0JGu1bfZtLKOMhnxBhU4",
    "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME": "doqeo9qgt",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID": "",
    "NEXT_PUBLIC_GTM_ID": "GTM-TWDZMRJW",
    "NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION": "",
    "SUPABASE_URL": "https://tbexpdwipdjgcjtlujis.supabase.co",
    "ADMIN_EMAILS": "dongwon.dwk@gmail.com",
    "CLOUDINARY_CLOUD_NAME": "doqeo9qgt"
  },
  "observability": {
    "enabled": true
  }
}
