DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Firebase Admin SDK verifies mobile Firebase ID tokens.
# For local/Vercel env vars, paste the private key with escaped newlines.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Admin emails allowed to use the web admin dashboard.
ADMIN_EMAILS="admin@example.com"

# Cloudinary configuration for plan cover image uploads.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
