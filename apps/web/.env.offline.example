# Local offline web testing — copy to apps/web/.env.local (optional)
# Default: `pnpm web:dev` already sets HUNNY_OFFLINE_MODE=1 — no DATABASE_URL needed.

HUNNY_OFFLINE_MODE=1
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

# Leave unset for fully offline public browse testing:
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# When you reconnect (step 3): use `pnpm web:dev:online` and restore Supabase vars above.
