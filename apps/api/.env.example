DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Neon Auth JWT verification (GET /api/v1/me — Authorization: Bearer <jwt>)
# JWKS URL is under your auth base path, e.g. …/neondb/auth/.well-known/jwks.json
NEON_AUTH_JWKS_URL=""
# Issuer and audience are the JWT `iss` / `aud` claims (Neon Auth host URL, no path).
NEON_AUTH_JWT_ISSUER=""
NEON_AUTH_JWT_AUDIENCE=""
