# OS
.DS_Store

# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

# Generated native folders can be created locally by flutter create
apps/mobile/android/
apps/mobile/macos/
apps/mobile/windows/
apps/mobile/linux/
apps/mobile/web/

# Drift generated files are build artifacts but usually committed in Flutter apps.
# Uncomment if you prefer not to commit generated code.
# apps/mobile/lib/**/*.g.dart

# Node
node_modules/
.next/
.open-next/
.wrangler/
out/
apps/web/tsconfig.tsbuildinfo
apps/web/.dev.vars
apps/web/cloudflare-env.d.ts

# apps/web is part of the pnpm workspace; a nested npm lockfile confuses Next.js
# monorepo root detection and can contribute to broken /_next/static asset paths.
apps/web/package-lock.json

# Env
.env
.env.local
.env.*.local
apps/mobile/.env*.json
!apps/mobile/.env.example.json

# Google OAuth client secrets (do not commit)
**/client_secret*.json
**/client_*secret*.json

# Generated/local root assets
/assets/

# Deprecated mobile icon source kept locally only.
apps/mobile/assets/icon/app-icon.png
supabase/.temp/
