{
  "name": "hunny-bible-tracker-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "pnpm run web:build",
    "web:dev": "pnpm --dir apps/web dev",
    "web:dev:online": "pnpm --dir apps/web dev:online",
    "web:build": "pnpm --dir apps/web build",
    "web:preview": "pnpm --dir apps/web preview",
    "web:deploy": "pnpm --dir apps/web run deploy",
    "bible-chapters:generate": "node scripts/generate-bible-chapters.mjs",
    "plan-estimates:update": "node scripts/update-plan-seed-estimates.mjs",
    "plan-estimates:write": "node scripts/update-plan-seed-estimates.mjs --write",
    "plan-estimates:write-migration": "node scripts/update-plan-seed-estimates.mjs --write-migration",
    "plan-estimates:sync-db": "node scripts/sync-plan-estimates-to-db.mjs",
    "plan-estimates:sync-db:write": "node scripts/sync-plan-estimates-to-db.mjs --write"
  }
}
